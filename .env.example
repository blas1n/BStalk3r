# ---- Alpaca API (PAPER TRADING ONLY) ----
# Create keys at https://app.alpaca.markets/ -> Paper account -> "View API Keys"
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Paper trading endpoint. NEVER point this at the live endpoint.
# Paper: https://paper-api.alpaca.markets   Live: https://api.alpaca.markets
# Startup refuses to run unless this is the paper host (see config.py guard).
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Hard guard: keep PAPER=true. The app refuses to start if false.
PAPER=true

# Market data feed. Free accounts only have IEX. Use "sip" only if subscribed.
DATA_FEED=iex

# ---- Safety / runtime ----
# When true: evaluate rules + log signals but place NO orders.
DRY_RUN=true

# SQLite database path (parent dirs are created automatically)
DB_PATH=data/bstalk3r.db

# Report output directory
REPORT_DIR=reports

# Universe source for the scanner:
#   watchlist -> evaluate the fixed UNIVERSE list below (Alpaca/IEX metrics)
#   polygon   -> screen the whole US market for top gainers via Polygon
UNIVERSE_SOURCE=watchlist

# Watchlist used when UNIVERSE_SOURCE=watchlist.
UNIVERSE=AAPL,TSLA,NVDA,AMD,SOFI,PLTR

# Polygon screener (used when UNIVERSE_SOURCE=polygon). Key from polygon.io.
#   POLYGON_INTRADAY=false -> grouped daily bars (FREE tier, end-of-day:
#     screens the prior session's runners; builds a research/next-day set)
#   POLYGON_INTRADAY=true  -> snapshot gainers (INTRADAY, requires a paid plan;
#     free tier returns 403 on this endpoint)
POLYGON_API_KEY=
POLYGON_INTRADAY=false
SCREENER_TOP_N=50

# ---- Scanner universe filters ----
MIN_PRICE=1.0
MAX_PRICE=50.0
MIN_DAY_CHANGE_PCT=5.0
MAX_DAY_CHANGE_PCT=40.0
MIN_RVOL=8.0
MIN_VOLUME_ACCELERATION=3.0
MAX_SPREAD_PCT=1.0

# ---- Risk management ----
MAX_RISK_PER_TRADE_PCT=0.01      # 1% of equity at risk per trade
MAX_POSITION_VALUE=2000.0        # max $ deployed in a single symbol
MAX_CONCURRENT_POSITIONS=2       # 1..3 typical
DAILY_MAX_LOSS_PCT=0.03          # halt new entries at -3% on the day
MAX_DAILY_TRADES=20

# ---- Strategy thresholds ----
STOP_LOSS_PCT=0.05               # -5%
TAKE_PROFIT_PCT=0.15             # +15% -> scale out
SCALE_OUT_FRACTION=0.5           # sell 50% at first target
TRAILING_STOP_PCT=0.08           # -8% from peak
MAX_HOLD_MINUTES=30
EXIT_SPREAD_PCT=1.5              # widening spread above this -> exit
FORCE_CLOSE_BEFORE_CLOSE_MINUTES=10   # flat this many minutes before the close

# ---- Execution ----
LIMIT_SLIPPAGE_PCT=0.003         # last_price * 1.003 upper bound for buy limit
ORDER_FILL_TIMEOUT_SEC=20        # cancel unfilled limit after N seconds
LOOP_INTERVAL_SEC=15             # scanner poll interval
